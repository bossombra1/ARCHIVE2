+        <td>{doc.created_at?.substring(0, 10)}</td>
+        <td>
+          <button className="btn btn-success btn-sm me-1" onClick={() => onEditSave(doc, title, description, typeId)}>
+            Enregistrer
+          </button>
+          <button className="btn btn-secondary btn-sm" onClick={onEditCancel}>
+            Annuler
+          </button>
+        </td>
+      </tr>
+    );
+  }
+
+  return (
+    <tr>
+      <td>{doc.id}</td>
+      <td>
+        <strong>{doc.title}</strong>
+        {doc.description && <div className="small text-muted">{doc.description}</div>}
+      </td>
+      <td>{doc.document_type?.name || '—'}</td>
+      <td>{doc.service?.name || '—'}</td>
+      <td>{formatSize(doc.file_size)}</td>
+      <td>{doc.created_at?.substring(0, 10)}</td>
+      <td>
+        <button className="btn btn-outline-primary btn-sm me-1" onClick={() => onDownload(doc)} title="Télécharger">
+          ⬇
+        </button>
+        <button className="btn btn-outline-secondary btn-sm me-1" onClick={onEditStart} title="Modifier">
+          ✎
+        </button>
+        <button className="btn btn-outline-danger btn-sm me-1" onClick={() => onDelete(doc)} title="Supprimer">
+          🗑
+        </button>
+        {canGrant && (
+          <button className="btn btn-outline-warning btn-sm" onClick={() => onOpenPermissions(doc)} title="Permissions">
+            🔐
+          </button>
+        )}
+      </td>
+    </tr>
+  );
+}
+
+/*
+|--------------------------------------------------------------------------
+| Sous-composant PermissionsModal
+|--------------------------------------------------------------------------
+*/
+function PermissionsModal({ title, permissions, loading, error, form, setForm, onAdd, onRevoke, onClose }) {
+  return (
+    <div className="modal d-block" tabIndex="-1" style={{ background: 'rgba(0,0,0,0.5)' }}>
+      <div className="modal-dialog modal-lg">
+        <div className="modal-content">
+          <div className="modal-header">
+            <h5 className="modal-title">Permissions — {title}</h5>
+            <button type="button" className="btn-close" onClick={onClose}></button>
+          </div>
+          <div className="modal-body">
+            {error && <div className="alert alert-danger">{error}</div>}
+
+            <form onSubmit={onAdd} className="mb-4">
+              <div className="row g-2 align-items-end">
+                <div className="col-md-3">
+                  <label className="form-label">Type de cible</label>
+                  <select
+                    className="form-select"
+                    value={form.target_type}
+                    onChange={(e) => setForm({ ...form, target_type: e.target.value })}
+                  >
+                    <option value="user">Utilisateur</option>
+                    <option value="poste">Poste</option>
+                    <option value="service">Service</option>
+                  </select>
+                </div>
+                <div className="col-md-3">
+                  <label className="form-label">ID de la cible</label>
+                  <input
+                    type="number"
+                    className="form-control"
+                    min="1"
+                    value={form.target_id}
+                    onChange={(e) => setForm({ ...form, target_id: e.target.value })}
+                    required
+                  />
+                </div>
+                <div className="col-md-3">
+                  <label className="form-label">Expire le (optionnel)</label>
+                  <input
+                    type="datetime-local"
+                    className="form-control"
+                    value={form.expires_at}
+                    onChange={(e) => setForm({ ...form, expires_at: e.target.value })}
+                  />
+                </div>
+                <div className="col-md-3">
+                  <button type="submit" className="btn btn-primary w-100">Accorder</button>
+                </div>
+              </div>
+              <small className="text-muted d-block mt-2">
+                Laissez « Expire le » vide pour une permission permanente.
+                La cible doit appartenir à votre entreprise et à votre périmètre.
+              </small>
+            </form>
+
+            {loading ? (
+              <p className="text-muted text-center">Chargement…</p>
+            ) : permissions.length === 0 ? (
+              <p className="text-muted text-center">Aucune permission enregistrée.</p>
+            ) : (
+              <table className="table table-sm table-striped">
+                <thead>
+                  <tr>
+                    <th>#</th>
+                    <th>Type</th>
+                    <th>Cible</th>
+                    <th>Expire le</th>
+                    <th>Statut</th>
+                    <th>Action</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {permissions.map((p) => (
+                    <tr key={p.id}>
+                      <td>{p.id}</td>
+                      <td>{p.target_type}</td>
+                      <td>{p.target_label || `#${p.target_id}`}</td>
+                      <td>{p.expires_at || 'Permanent'}</td>
+                      <td>
+                        {p.is_expired
+                          ? <span className="badge bg-danger">Expirée</span>
+                          : p.is_permanent
+                            ? <span className="badge bg-success">Permanente</span>
+                            : <span className="badge bg-info">Valide</span>}
+                      </td>
+                      <td>
+                        <button className="btn btn-sm btn-outline-danger" onClick={() => onRevoke(p.id)}>
+                          Révoquer
+                        </button>
+                      </td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            )}
+          </div>
+          <div className="modal-footer">
+            <button className="btn btn-secondary" onClick={onClose}>Fermer</button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
